# Supabase public browser values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only: super admin orqali klinika loginlarini yaratish/reset qilish uchun.
# Hech qachon NEXT_PUBLIC_ prefiksi bilan yozmang va browserga uzatmang.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
